# Local development uses SQLite. Point DATABASE_URL at a Supabase Postgres
# connection string to run on Supabase (see README: "Supabase and Clerk").
DATABASE_URL="file:./prisma/dev.db"
# DATABASE_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"

AUTH_SECRET="replace-with-a-long-random-string"

# Only these campus addresses can sign up or sign in
NEXT_PUBLIC_CAMPUS_EMAIL_DOMAIN="uetpeshawar.edu.pk"
NEXT_PUBLIC_CAMPUS_NAME="UET Peshawar"

# Clerk (optional — unset means the built-in cookie sessions are used)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""
