# Postgres connection string (Prisma Postgres, Supabase, or a local server)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus"

AUTH_SECRET="replace-with-a-long-random-string"

# Only these campus addresses can sign up or sign in
NEXT_PUBLIC_CAMPUS_EMAIL_DOMAIN="uetpeshawar.edu.pk"
NEXT_PUBLIC_CAMPUS_NAME="UET Peshawar"

# Clerk (optional — unset means the built-in cookie sessions are used)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""
